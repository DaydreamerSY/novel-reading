__pycache__/
*.pyc
*.tmp

# translator: re-buildable cache, exports, run logs, glossary backups
translator/data/cache/
translator/data/logs/
translator/data/*.txt
translator/output/
translator/books/*/glossary.yaml.bak*

.claude/settings.local.json

# English source, never published:
# raw scrapes of every site, and the English each book is translated from
translator/data/sources/
translator/data/books/*/en/
# translations carry the English source line by line
translator/data/books/*/vi/
# older layouts, in case an old script recreates them
translator/data/en/
translator/data/en_novelight/
translator/data/novelight/
translator/data/novellunar/
translator/data/vi/
translator/glossary.yaml.bak*
